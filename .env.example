# Example configuration. Copy to .env (never commit real values).
# The frontend itself reads config.js (see README); these are used by the
# GitHub Pages workflow (as repository variables) and the Supabase CLI.

# Frontend (public by design: access is enforced by the database)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase CLI (for `npx supabase link` / `npx supabase db push`) — keep secret
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
